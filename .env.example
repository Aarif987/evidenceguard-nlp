# HTL-VIE Environment Configuration
# Copy this file to .env and configure your credentials if performing live inference.

# Gemini API Key (optional for mock mode, required for live LLM extraction)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model (e.g., gemini-3.8-flash, gemini-3.7-flash, gemini-3.6-flash, gemini-3.5-flash, gemini-3.1-flash-lite, gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.5-pro)
GEMINI_MODEL=gemini-3.8-flash

# Gemini API Timeout & Bounded Retry Configuration
GEMINI_TIMEOUT_SECONDS=60.0
GEMINI_MAX_RETRIES=2
GEMINI_MAX_OUTPUT_TOKENS=2048

# GLiNER Model Checkpoint (HuggingFace identifier)
GLINER_MODEL=urchade/gliner_small-v2.1

# Pipeline Execution Mode: 'auto' (uses API if key exists, else mock), 'live', or 'mock'
PIPELINE_MODE=auto

