# HTL-VIE Environment Configuration
# Copy this file to .env and configure your credentials if performing live inference.

# Gemini API Key (optional for mock mode, required for live LLM extraction)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model (e.g., gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash

# GLiNER Model Checkpoint (HuggingFace identifier)
GLINER_MODEL=urchade/gliner_small-v2.1

# Pipeline Execution Mode: 'auto' (uses API if key exists, else mock), 'live', or 'mock'
PIPELINE_MODE=auto
